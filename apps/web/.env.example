# Free project ID from https://cloud.walletconnect.com — needed for the
# WalletConnect QR/mobile flow. Browser-extension wallets (MetaMask, etc.)
# still connect fine without a real one during local development.
VITE_WALLETCONNECT_PROJECT_ID=

# Public IPFS gateway used to resolve ipfs:// URIs. Defaults to ipfs.io.
VITE_IPFS_GATEWAY=

# Supabase project URL and anon/public API key (Project Settings → API).
# Powers The Studio's session save/load. Without these, everything else in
# The Studio still works — saving/loading a session just isn't available.
# Run apps/web/supabase/schema.sql in the Supabase SQL Editor first, and
# create a public Storage bucket named "studio-audio".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Pinata JWT (no VITE_ prefix — server-side only, never shipped to the
# client). Powers real IPFS pinning for minted tracks. Without it, audio
# gets embedded directly as a data: URI instead — fine for a tiny test
# clip, but real recordings are far too large: the resulting on-chain
# calldata blows past the block gas limit and minting fails outright.
# Free account + API key at https://app.pinata.cloud.
PINATA_JWT=

# Server-only secrets powering Sign-In with Ethereum for The Studio
# (proves a client actually controls the wallet it claims, so
# collaborator RLS can key off it instead of trusting a plain address
# column). Both from your Supabase project's Settings → API page.
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS — never expose it to the client.
# SUPABASE_JWT_SECRET is under "JWT Settings" → "Legacy JWT Secret"; if
# your project only shows rotating/asymmetric JWT signing keys, enable
# the legacy secret there first — this HS256 flow needs a shared secret.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
