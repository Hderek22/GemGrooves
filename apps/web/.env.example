# Free project ID from https://cloud.walletconnect.com — needed for the
# WalletConnect QR/mobile flow. Browser-extension wallets (MetaMask, etc.)
# still connect fine without a real one during local development.
VITE_WALLETCONNECT_PROJECT_ID=

# Public IPFS gateway used to resolve ipfs:// URIs. Defaults to ipfs.io.
VITE_IPFS_GATEWAY=
