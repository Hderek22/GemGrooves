PRIVATE_KEY=your_private_key_here
BASESCAN_KEY=your_basescan_api_key_here

# Optional deploy.js overrides.
# USDC_ADDRESS defaults to Circle's real address (verified against BaseScan,
# same on Base Sepolia and mainnet). DAI_ADDRESS defaults to a freshly
# deployed mock on testnet (Base Sepolia has no official DAI) — REQUIRED
# for a mainnet deploy, deploy.js refuses to guess at one.
# USDC_ADDRESS=
# DAI_ADDRESS=
# PLATFORM_FEE_BPS=250
# FEE_RECIPIENT=
